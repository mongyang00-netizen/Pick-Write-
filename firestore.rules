rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTeacher() {
      return isVerifiedUser() && request.auth.token.email == 'mongyang00@gmail.com';
    }

    // --- Validation Blueprints ---
    function isValidLevel(lvl) {
      return lvl is int && lvl >= 1 && lvl <= 3;
    }

    function isValidStudentProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'currentLevel', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'currentLevel', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && isValidLevel(data.currentLevel)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWritingRecord(data) {
      return data.keys().hasAll([
          'uid', 'studentName', 'topic', 'topicTitle', 'level', 'nextLevel',
          'hintsUsed', 'planQ1', 'planQ2', 'planQ3', 'planQ4',
          'firstDraft', 'finalParagraph', 'reflection',
          'aiPraise', 'aiFixPoint', 'aiQuestion', 'fixedOnFirstTry', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'studentName', 'topic', 'topicTitle', 'level', 'nextLevel',
          'hintsUsed', 'planQ1', 'planQ2', 'planQ3', 'planQ4',
          'firstDraft', 'finalParagraph', 'reflection',
          'aiPraise', 'aiFixPoint', 'aiQuestion', 'fixedOnFirstTry', 'createdAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100
        && data.topic is string && data.topic in ['food', 'place', 'hobby']
        && data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 60
        && isValidLevel(data.level)
        && isValidLevel(data.nextLevel)
        && data.hintsUsed is int && data.hintsUsed >= 0 && data.hintsUsed <= 3
        && data.planQ1 is string && data.planQ1.size() <= 300
        && data.planQ2 is string && data.planQ2.size() <= 300
        && data.planQ3 is string && data.planQ3.size() <= 300
        && data.planQ4 is string && data.planQ4.size() <= 300
        && data.firstDraft is string && data.firstDraft.size() >= 1 && data.firstDraft.size() <= 2000
        && data.finalParagraph is string && data.finalParagraph.size() >= 1 && data.finalParagraph.size() <= 2000
        && data.reflection is string && data.reflection.size() <= 500
        && data.aiPraise is string && data.aiPraise.size() <= 400
        && data.aiFixPoint is string && data.aiFixPoint.size() <= 400
        && data.aiQuestion is string && data.aiQuestion.size() <= 400
        && data.fixedOnFirstTry is bool
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isTeacher());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidStudentProfile(incoming())
        && incoming().currentLevel == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidStudentProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'currentLevel', 'updatedAt']);
      allow delete: if false;
    }

    match /writingRecords/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && (existing().uid == request.auth.uid || isTeacher());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isVerifiedUser()
        && isValidId(recordId)
        && isValidWritingRecord(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
